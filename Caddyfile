:80 {
	# FastAPI:健康检查 + 登录/T5 的鉴权接口
	reverse_proxy /health fastapi:8000
	reverse_proxy /api/* fastapi:8000

	# Hermes Dashboard:strip /hermes 前缀后转发(Hermes 自身在根路径)。
	# T1 阶段不挂 forward_auth;T5 会在本块加 forward_auth /auth-check。
	handle_path /hermes/* {
		reverse_proxy hermes:9119
	}

	# 其余路径:React 公开首页(Vite dev server;生产改为静态 file_server)
	reverse_proxy frontend:5173
}
