{
	# 本地 dev:关掉 admin API。Caddy 对 .localhost 用 plain HTTP(http:// 前缀)。
	admin off
}

# 主站(localhost):公开首页 + 登录/me/auth-check 等 API
http://localhost {
	reverse_proxy /health fastapi:8000
	reverse_proxy /api/* fastapi:8000
	reverse_proxy /auth-check fastapi:8000

	# 其余路径:React 公开首页(Vite dev server;生产改为静态 file_server)
	reverse_proxy frontend:5173
}

# Hermes(端口区分 localhost:8081):与主站 localhost:8080 同 host、不同端口,受 forward_auth 保护。
# 用户的每个请求先打 fastapi /auth-check(带原始 Cookie):
#   有效 owwo session → 2xx → 放行,反代到共享网络命名空间里的 loopback hermes
#   无 session → 302 → Caddy 透传给浏览器 → 跳主站 /login?next=<hermes URL>
# 为何用端口而非子域:浏览器不把 Domain=localhost 的 cookie 发往 *.localhost 子域
# (curl 域匹配较宽松故原冒烟通过,真实浏览器登录循环)。端口区分下 cookie 不设 Domain,
# host 同为 localhost → 跨端口共享,auth-check 能读到 session。生产子域名部署见 ADR-0002。
http://:81 {
	# WebSocket 请求(带 Upgrade 头)绕过 forward_auth 直接反代。
	# 原因:Caddy forward_auth 会剥离 hop-by-hop 的 Connection/Upgrade 头,
	# 导致 Hermes 收到普通 GET 而非 WS 握手 → FastAPI websocket 路由 403。
	# WS 改由 Hermes 自身的 ?token= 认证 —— token 嵌在根 HTML 的 __HERMES_SESSION_TOKEN__,
	# 而根 HTML 受下方 forward_auth 保护(只有过了 owwo 登录的浏览器才拿得到),安全性等价。
	@ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy 127.0.0.1:9119 {
			header_up Host 127.0.0.1
		}
	}
	# 非 WS 请求(页面 HTML、REST API):先 forward_auth 校验 owwo session,再反代
	handle {
		forward_auth fastapi:8000 {
			uri /auth-check
		}
		reverse_proxy 127.0.0.1:9119 {
			header_up Host 127.0.0.1
		}
	}
}
