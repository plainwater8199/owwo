# owwo 生产密钥模板。复制为 .env 并填入真实值(.gitignore 已忽略 .env*,但放行 .env.example)。
# 生成命令(各跑一次,分别填入下面两项):
#   openssl rand -hex 32

# FastAPI 会话签名密钥(itsdangerous 签名 cookie 用)。泄漏 = 可伪造任意登录态。
OWWO_SECRET_KEY=

# Hermes dashboard loopback 软认证 token(嵌在根 HTML 里供 SPA WS 鉴权)。
# 虽然只有过了 owwo 登录的浏览器才拿得到,但仍是秘密,必须高熵。
HERMES_DASHBOARD_SESSION_TOKEN=
