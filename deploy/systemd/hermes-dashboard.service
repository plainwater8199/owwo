# Hermes Dashboard 的 systemd 单元模板(ADR-0003 原生部署)。
# 复制到 /etc/systemd/system/hermes-dashboard.service,再把密钥写入
# /etc/hermes-dashboard.env(见下),然后:
#   sudo systemctl daemon-reload && sudo systemctl enable --now hermes-dashboard
#
# gateway 不在此文件:官方安装器自带 systemd 集成(更新后自动重启 gateway),
# 消息平台接入由它承载。CentOS 7(systemd 219 缺 user@.service)用系统级安装:
#   sudo /home/hermes/.local/bin/hermes gateway install --system --run-as-user hermes --no-start-now
# 本单元只管 dashboard(nginx 反代的 127.0.0.1:9119)。
#
# /etc/hermes-dashboard.env(root:root 600,模板):
#   HERMES_DASHBOARD=1
#   HERMES_DASHBOARD_HOST=127.0.0.1
#   HERMES_DASHBOARD_PORT=9119
#   HERMES_DASHBOARD_SESSION_TOKEN=<openssl rand -hex 32 生成的高熵值>
#   HERMES_DASHBOARD_PUBLIC_URL=https://hermes.owwo.cn
#   HERMES_DISABLE_LAZY_INSTALLS=1
#
# ✅ 已验证(2026-08-15):原生 `hermes dashboard` 认 HERMES_DASHBOARD_SESSION_TOKEN,
# WS ?token= 握手 101。另:dashboard 启动会校验 web 前端构建产物 + 内容哈希 stamp,
# CentOS 7 无 node 时用 /usr/local/bin/hermes-web-build(hermes 镜像内构建)重建,
# 见 NATIVE-HERMES-MIGRATION.md 实施记录第 5 条。

[Unit]
Description=Hermes Agent Dashboard (web frontend, loopback :9119)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
# 原生安装(per-user 布局)的可执行文件路径;服务用户无交互 shell 登录,
# PATH 可能不含 ~/.local/bin,故写绝对路径。
ExecStart=/home/hermes/.local/bin/hermes dashboard
EnvironmentFile=/etc/hermes-dashboard.env
Restart=on-failure
RestartSec=5
# dashboard 加载 skills 慢,给足启动判定时间,别让 systemd 误杀重启。
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
